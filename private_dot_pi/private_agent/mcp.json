{
  "settings": {
    "requestTimeoutMs": 120000
  },
  "mcpServers": {
    "smuggler": {
      "transport": "stdio",
      "command": "/usr/bin/uv",
      "args": [
        "run",
        "--project",
        "/home/ta/projects/smuggler",
        "smuggler-mcp"
      ],
      "lifecycle": "eager"
    },
    "hindsight": {
      "transport": "stdio",
      "command": "/usr/bin/uv",
      "args": [
        "run",
        "--project",
        "/home/ta/projects/hindsight",
        "python",
        "/home/ta/projects/hindsight/server.py"
      ],
      "lifecycle": "eager"
    }
  }
}
