// niri config — sole Wayland compositor since 2026-05-23 (Hyprland removed).
// See ~/projects/niri/PLAN.md for migration history.

// Reference: https://github.com/niri-wm/niri/wiki/Configuration

input {
    keyboard {
        xkb {
            layout "us"
            options "ctrl:nocaps"
        }
    }
    touchpad {
        tap
        dwt              // disable-while-typing
        // natural-scroll intentionally omitted (= disabled). It's a boolean toggle in niri, not a key=value.
        // drag-lock not yet exposed as a niri option — revisit when upstream lands it
    }
    mouse {}
    focus-follows-mouse max-scroll-amount="0%"
}

// Monitors — laptop + external TV.
// External TV: 1366x768 native, no overscan. Positioned to the right.
output "DP-1" {
    mode "1366x768@59.79"
    position x=1728 y=0
    scale 1.0
}

environment {
    XCURSOR_THEME "Adwaita"
    XCURSOR_SIZE "20"

    // ssh-agent: fixed socket (agent spawned at startup below). Literal uid 1000
    // — niri's environment{} doesn't shell-expand $XDG_RUNTIME_DIR.
    SSH_AUTH_SOCK "/run/user/1000/ssh-agent.sock"

    // NVIDIA Wayland
    GBM_BACKEND "nvidia-drm"
    __GLX_VENDOR_LIBRARY_NAME "nvidia"
    WLR_NO_HARDWARE_CURSORS "1"

    // fcitx5 input method (GTK_IM_MODULE intentionally unset — Wayland IM frontend)
    QT_IM_MODULE "fcitx"
    XMODIFIERS "@im=fcitx"

    // HYPRCURSOR_* intentionally dropped — niri uses XCURSOR_*.
}

layout {
    gaps 5
    center-focused-column "never"
    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }
    default-column-width { proportion 0.5; }

    focus-ring {
        width 1.5
        active-color "#99a0d5"
        inactive-color "#494d64"
    }

    border {
        off
    }

    shadow {
        on
        softness 25
        spread 3
        offset x=0 y=4
        color "#00000059"
    }
}

prefer-no-csd

cursor {
    xcursor-theme "Adwaita"
    xcursor-size 20
}

hotkey-overlay {
    skip-at-startup
}

screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

// Autostart — mirror of ~/.config/hypr/hyprland.d/autostarts.conf.
spawn-at-startup "swaybg" "-i" "/home/ta/.wallpapers/monochrome.png"
// PipeWire/wireplumber/pipewire-pulse are now supervised by runit (~/service/),
// independent of compositor lifetime. start-sound.sh removed from autostart.
spawn-at-startup "/usr/libexec/polkit-gnome-authentication-agent-1"
spawn-at-startup "mako"
spawn-at-startup "runsvdir" "/home/ta/service"
spawn-at-startup "fcitx5" "-d"
spawn-at-startup "udiskie" "--tray"

// ssh-agent on a fixed socket (SSH_AUTH_SOCK set in environment{} above).
// rm stale socket first — same idiom as the wob FIFOs below. AddKeysToAgent
// (~/.ssh/config) caches the key on first use, so passphrase is typed once per boot.
spawn-at-startup "sh" "-c" "rm -f $XDG_RUNTIME_DIR/ssh-agent.sock; exec ssh-agent -D -a $XDG_RUNTIME_DIR/ssh-agent.sock"

// wob FIFOs — sh -c needed for the redirect/pipe chain.
spawn-at-startup "sh" "-c" "rm -f $XDG_RUNTIME_DIR/wob-vol.sock && mkfifo $XDG_RUNTIME_DIR/wob-vol.sock && tail -f $XDG_RUNTIME_DIR/wob-vol.sock | wob -c ~/.config/wob/volume.ini"
spawn-at-startup "sh" "-c" "rm -f $XDG_RUNTIME_DIR/wob-br.sock && mkfifo $XDG_RUNTIME_DIR/wob-br.sock && tail -f $XDG_RUNTIME_DIR/wob-br.sock | wob -c ~/.config/wob/brightness.ini"

// eww bar retired 2026-05-21 — config archived to ~/obsidian-vault/system/configs/eww/.
// Replaced with on-demand notifications (clock/weather binds).

// swayidle replaces hypridle. Timings + invocation live in the launcher script;
// keeping them out of KDL avoids brittle multi-line spawn-at-startup argv
// (which silently swallowed the previous draft and never spawned swayidle).
spawn-at-startup "/home/ta/.local/bin/niri-swayidle.sh"

// Inhibit idle only while PipeWire is actually outputting audio. Pairs with
// media.wakelock=false in Firefox's user.js: silent/paused tabs no longer
// freeze the idle clock, but real playback still keeps the screen awake.
spawn-at-startup "wayland-pipewire-idle-inhibit"

// Keybinds — port of ~/.config/hypr/hyprland.d/keybinds.conf.
binds {
    Mod+C       { close-window; }
    Mod+V       { toggle-window-floating; }
    Mod+Return  { spawn "ghostty"; }
    Mod+Shift+Return { spawn "foot"; }  // break-glass + tmux/persistence terminal (#79, replaced alacritty)
    Mod+Grave   { spawn "sh" "-c" "export SCRATCH_TERM=1; exec ghostty --gtk-single-instance=false --class=com.ghostty.scratch"; }  // floating scratch terminal (#79); SCRATCH_TERM suppresses fish greeting; close with Mod+C
    Mod+D       { spawn "sh" "-c" "pkill fuzzel || fuzzel"; }  // launcher — fuzzel (install: sudo xbps-install -S fuzzel)
    Mod+Shift+Q { spawn "power-menu"; }
    Mod+Shift+E { quit skip-confirmation=true; }  // direct-exit fallback
    Mod+L       { spawn "hyprlock"; }  // ext-session-lock-v1; deps: hyprcursor/hyprgraphics/hyprlang/hyprutils

    // Scrollable-tiling essentials
    Mod+F       { fullscreen-window; }
    Mod+M       { maximize-column; }
    Mod+W       { toggle-overview; }
    Mod+R       { switch-preset-column-width; }
    Mod+Comma   { consume-or-expel-window-left; }
    Mod+Period  { consume-or-expel-window-right; }
    Mod+Home    { focus-column-first; }
    Mod+End     { focus-column-last; }

    Mod+Shift+Slash { show-hotkey-overlay; }  // Mod+? — re-show keybind help
    Mod+Slash       { spawn "niri-palette"; } // fuzzel command palette for niri actions

    Mod+Left    { focus-column-left; }
    Mod+Right   { focus-column-right; }
    Mod+Up      { focus-window-up; }
    Mod+Down    { focus-window-down; }

    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+0 { focus-workspace 10; }

    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }
    Mod+Shift+5 { move-column-to-workspace 5; }
    Mod+Shift+6 { move-column-to-workspace 6; }
    Mod+Shift+7 { move-column-to-workspace 7; }
    Mod+Shift+8 { move-column-to-workspace 8; }
    Mod+Shift+9 { move-column-to-workspace 9; }
    Mod+Shift+0 { move-column-to-workspace 10; }

    // Mod+S / Mod+Shift+S — Hyprland toggle-hide scratchpad has no niri equivalent
    // (niri lacks window-hide + global shortcuts). Closest fit: the Mod+Grave floating
    // scratch terminal above — spawn-floating for one-off use, not toggle-hide. See IDEAS #79.

    // Multimedia keys — same wpctl/brightnessctl/wob commands as Hyprland.
    XF86AudioRaiseVolume allow-when-locked=true { spawn "sh" "-c" "wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+; timeout 0.1 bash -c 'wpctl get-volume @DEFAULT_AUDIO_SINK@ | awk \"{printf \\\"%d\\\\n\\\", \\$2*100}\" > $XDG_RUNTIME_DIR/wob-vol.sock'"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "sh" "-c" "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-; timeout 0.1 bash -c 'wpctl get-volume @DEFAULT_AUDIO_SINK@ | awk \"{printf \\\"%d\\\\n\\\", \\$2*100}\" > $XDG_RUNTIME_DIR/wob-vol.sock'"; }
    XF86AudioMute        allow-when-locked=true { spawn "sh" "-c" "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle; timeout 0.1 bash -c 'wpctl get-volume @DEFAULT_AUDIO_SINK@ | grep -q MUTED && echo 0 > $XDG_RUNTIME_DIR/wob-vol.sock || wpctl get-volume @DEFAULT_AUDIO_SINK@ | awk \"{printf \\\"%d\\\\n\\\", \\$2*100}\" > $XDG_RUNTIME_DIR/wob-vol.sock'"; }
    XF86AudioMicMute     allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SOURCE@" "toggle"; }
    XF86MonBrightnessUp  allow-when-locked=true { spawn "sh" "-c" "brightnessctl s 10%+; timeout 0.1 bash -c 'brightnessctl -m | awk -F, \"{print substr(\\$4, 0, length(\\$4)-1)}\" > $XDG_RUNTIME_DIR/wob-br.sock'"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "sh" "-c" "brightnessctl s 10%-; timeout 0.1 bash -c 'brightnessctl -m | awk -F, \"{print substr(\\$4, 0, length(\\$4)-1)}\" > $XDG_RUNTIME_DIR/wob-br.sock'"; }

    XF86AudioNext  allow-when-locked=true { spawn "playerctl" "next"; }
    XF86AudioPause allow-when-locked=true { spawn "playerctl" "play-pause"; }
    XF86AudioPlay  allow-when-locked=true { spawn "playerctl" "play-pause"; }
    XF86AudioPrev  allow-when-locked=true { spawn "playerctl" "previous"; }

    Print       { spawn "screenshot-region"; }
    Mod+Print   { spawn "screenshot-menu"; }

    Mod+I       { spawn "fcitx5-switch"; }
    Mod+E       { spawn "ghostty" "-e" "yazi"; }
}

// Window rules — port of ~/.config/hypr/hyprland.d/windows-and-workspaces.conf.
// niri has no "maximize" concept → no suppressevent rule needed.
// "no gaps when only" (`w[tv1]`/`f[1]`) has no conditional-gaps equivalent
// in niri — accepted regression, gaps stay uniform.

// Global: round all window corners. clip-to-geometry trims the actual content
// to match (otherwise apps draw past the rounded mask).
window-rule {
    geometry-corner-radius 6
    clip-to-geometry true
}

// Subtle dimming of unfocused windows.
window-rule {
    match is-active=false
    opacity 0.96
}

// Terminals: open at full column width (visual parity with how firefox feels)
window-rule {
    match app-id="com.mitchellh.ghostty"
    match app-id="foot"
    default-column-width { proportion 1.0; }
}

window-rule {
    match app-id="org.pulseaudio.pavucontrol"
    open-floating true
}
window-rule {
    match app-id="blueman-manager"
    open-floating true
}
window-rule {
    match app-id=r#"^(Firefox|firefox)$"# title="^Library$"
    open-floating true
}
window-rule {
    match app-id=r#"^(Firefox|firefox)$"# title="^Extension:"
    open-floating true
}

// Picture-in-Picture (#67): browser PiP gets tiled by default — force it floating.
// NOTE: this floats it above tiled windows ON ITS WORKSPACE only. niri has no native
// cross-workspace "always on top" (each workspace owns its floating layer); for the
// "follow me across workspaces" behaviour run the niri-float-sticky daemon (see #67).
window-rule {
    match title="^Picture-in-Picture$"
    open-floating true
    default-column-width { fixed 480; }
    default-window-height { fixed 270; }
    default-floating-position x=32 y=32 relative-to="bottom-right"
}

// Floating scratch terminal (#79): Mod+Grave → ghostty --class=com.ghostty.scratch,
// for one-off throwaway use (calc/notes). Spawn → use → Mod+C to close. Not a
// toggle-hide dropdown (niri lacks global shortcuts — see IDEAS #79).
window-rule {
    match app-id=r#"^com\.ghostty\.scratch$"#
    open-floating true
    default-column-width { fixed 1200; }
    default-window-height { fixed 540; }
    default-floating-position x=0 y=64 relative-to="top"
}

// Idle inhibit for fullscreen video: handled by mpv/Firefox via the
// idle-inhibit-v1 protocol — no niri-side rule needed.
// niri's `block-out-from` controls screencast privacy, not idle, so the
// previous draft rule was a wrong analogue and has been removed.
// If idle still triggers during fullscreen video, install sway-audio-idle-inhibit
// as a fallback (in xbps repos).

// #74 accent-only theming: focus-ring colors are generated by matugen
// (templates in ~/.config/matugen/). This include OVERRIDES the focus-ring
// colors in the layout block above. Regenerate/switch scheme:
//   matugen image ~/.wallpapers/monochrome.png -t scheme-neutral|scheme-monochrome
include "/home/ta/.config/niri/accent.kdl"
