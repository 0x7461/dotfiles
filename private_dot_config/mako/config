font=Monospace 12
width=300
height=300
margin=10
padding=8
border-size=2
border-radius=8
border-color=#8aadf4
background-color=#24273a
text-color=#cad3f5
default-timeout=5000
group-by=app-name
icon-path=/usr/share/icons/Adwaita
max-icon-size=64
layer=overlay
anchor=top-right

# CC fires notifications via two channels simultaneously:
# 1. claude-code-hook — direct D-Bus (always fires, terminal-agnostic)
# 2. OSC 9 escape code → Ghostty forwards to D-Bus (only in Ghostty)
# Suppress the direct one so only Ghostty's native notification shows.
# If CC is ever run in a non-OSC9 terminal, re-enable this.
[app-name="claude-code-hook"]
invisible=1

[urgency=low]
border-color=#8aadf4
background-color=#24273a
text-color=#cad3f5

[urgency=critical]
border-color=#f5a97f
background-color=#24273a
text-color=#cad3f5
default-timeout=0
