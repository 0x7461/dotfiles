#!/bin/sh
exec 2>&1
export HOME=/home/ta
cd /home/ta/projects/archivist

# Two-instance merge with the NAS (agent_docs/two-instance.md). Twice daily, an
# hour after the NAS's stories pulls (06:00/18:00) and well after the laptop's
# (00:00/12:00), so each round carries both machines' latest stories across.
# -t/-s: a round missed while the laptop was off runs as soon as the service
# starts. The stamp is touched whatever the outcome — a failure too — or runit's
# restart would rerun a failing round back to back; --alert reports failures.
STAMP=/home/ta/.local/share/archivist/merge/last-round
mkdir -p /home/ta/.local/share/archivist/merge
exec snooze -H7,19 -M0 -s 12h -J1800 -t "$STAMP" \
  sh -c '/home/ta/projects/archivist/.venv/bin/archivist merge --apply --alert; rc=$?; touch "$0"; exit $rc' "$STAMP"
