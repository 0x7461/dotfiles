#!/bin/sh
exec 2>&1
export HOME=/home/ta
cd /home/ta/projects/archivist

# Two-instance merge with the NAS (agent_docs/two-instance.md). Twice daily, an
# hour after the NAS's stories pulls (06:00/18:00) and well after the laptop's
# (00:00/12:00), so each round carries both machines' latest stories across.
# Catch-up (obsidian-vault/system/services.md, late-boot gotcha): a round missed
# while the laptop was off runs as soon as the service starts. The timefile is
# touched *before* the round, so a failing round waits for the next slot instead
# of looping; --alert reports it.
#
# Jitter is a shell sleep, not snooze -J: find_next applies -J to every candidate
# of the -t catch-up search, so a jittered missed slot lands past -s and the final
# find_next skips to the next slot (booted 2026-10-08 08:33 -> next fire 19:00).
# The sleep keeps the jitter's purpose: spread boot catch-ups and give the NAS time
# to come up before the push. Verify with `snooze -v`, not -n (-n suppresses jitter).
tf=/home/ta/.local/state/snooze/archivist-merge
mkdir -p /home/ta/.local/state/snooze
exec snooze -H7,19 -M0 -s 12h -t "$tf" \
  sh -c 'touch "$1" && sleep "$(shuf -i 0-1800 -n1)" && exec /home/ta/projects/archivist/.venv/bin/archivist merge --apply --alert' sh "$tf"
