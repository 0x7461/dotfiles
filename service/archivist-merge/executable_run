#!/bin/sh
exec 2>&1
export HOME=/home/ta
cd /home/ta/projects/archivist

# Two-instance merge with the NAS (agent_docs/two-instance.md). Twice daily, an
# hour after the NAS's stories pulls (06:00/18:00) and well after the laptop's
# (00:00/12:00), so each round carries both machines' latest stories across.
# Catch-up (services.md, late-boot gotcha): a round missed while the laptop was off
# runs as soon as the service starts. The timefile is touched *before* the round, so
# a failing round waits for the next slot instead of looping; --alert reports it.
tf=/home/ta/.local/state/snooze/archivist-merge
mkdir -p /home/ta/.local/state/snooze
exec snooze -H7,19 -M0 -s 12h -J1800 -t "$tf" \
  sh -c 'touch "$1" && exec /home/ta/projects/archivist/.venv/bin/archivist merge --apply --alert' sh "$tf"
