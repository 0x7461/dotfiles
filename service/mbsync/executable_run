#!/bin/sh
exec 2>&1
# 75 = deferred (the job never started), never 1 — see wait-net.
/home/ta/.local/bin/wait-net 300 || exit 75
# runit run-script for periodic Gmail sync (#46 Phase 1).
# Live under ~/service/mbsync since Phase 1 went live; this is the canonical copy.
#
# (Re)install:
#   mkdir -p ~/service/mbsync
#   cp ~/.config/mbsync/mbsync.run ~/service/mbsync/run
#   chmod +x ~/service/mbsync/run
#   install -m 755 ~/projects/caretaker/service-hooks/finish ~/service/mbsync/finish
#   # runsv auto-discovers it and starts syncing every 15 min.
#   # Pause with:  SVDIR=~/service sv down mbsync
#
# snooze, not an in-process `while … sleep` loop (converted 2026-08-02). snooze
# runs the command once and exits, so runsv restarts per cycle and the `finish`
# hook records each run's exit status. A loop that never exits can never fire
# `finish`, so a sync failing every 15 minutes was completely invisible — new
# mail would simply stop arriving with nothing to say so. caretaker (then maint-watch) reported
# it UNREPORTABLE.
#
# `sh -c` because the exit status must reflect both halves: a successful pull
# followed by a failed reindex is still a failed run.

# Every 6 hours (00:00 / 06:00 / 12:00 / 18:00). Was every 15 minutes, which the
# initial backfill needed and steady state does not — mail is never more than 6h
# stale for 1/24th of the work.
#
# `-t` + `-s 6h` give catch-up: a window missed because the laptop was asleep
# fires on wake instead of being skipped until the next one. That matters at this
# cadence — a skipped 15-minute window was nothing, a skipped 6-hour window is
# most of a day. snooze never writes the timefile itself; the job must touch it.
# Until 2026-09-28 nothing did, so there was no catch-up (only the default 60s
# slack) and every window ran ~4 times within its first minute. Touch comes
# first, so a failed sync waits for the next window rather than looping. The
# timefile lives in ~/.local/state, not tmpfs /tmp, so a reboot doesn't reset it.
# (See the late-boot gotcha in ~/obsidian-vault/system/services.md.)
#
# **Verify any spec change with `snooze -v <spec> true` before installing.**
# snooze defaults an *unspecified* field to 0, not "any": bare `-M/15` means
# "every 15th minute of hour 0" and silently parks the service until midnight.
# That happened here on 2026-08-02 and `sv status` still read `run` throughout.
exec 2>&1
tf=/home/ta/.local/state/snooze/mbsync
mkdir -p "${tf%/*}"
# The notification lives here, not in a mbsync PostSynchronization hook: one
# place, and the run status already covers both halves. One notification per
# sync, never per message; crier's alert lane (the existing ntfy topic);
# --priority low so a 00:00/06:00 sync arrives silently. A failed notify never
# costs the run: mail arrived, which is what the status records.
exec snooze -t "$tf" -s 6h -H/6 -M0 sh -c '
  touch "$1"
  mbsync -a || exit 1
  out=$(notmuch new) || { echo "$out"; exit 1; }
  n=$(printf "%s\n" "$out" | sed -n "s/^Added \([0-9][0-9]*\) new message.*/\1/p" | head -1)
  if [ -n "$n" ] && [ "$n" -gt 0 ] 2>/dev/null; then
    subs=$(notmuch search --format=json --limit=3 "tag:unread" 2>/dev/null | jq -r ".[].subject")
    body="$n new message(s)"
    [ -n "$subs" ] && body="$body — $subs"
    crier alert --source email --title "new mail" --priority low --tags envelope "$body" \
      || echo "mbsync: crier alert failed"
  fi
' sh "$tf"
