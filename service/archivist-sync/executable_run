#!/bin/sh
exec 2>&1
/home/ta/.local/bin/wait-net 120 || exit 75   # 75 = deferred (the job never started), not 1 — see wait-net
export HOME=/home/ta
cd /home/ta/projects/archivist

# On startup: catch up if last sync was missed (>16h ago), jittered so the boot
# catch-ups across archivist-* don't all hit the account at once. This runs before
# `exec snooze`, so ./finish (which fires when the run script exits) never sees it —
# record the outcome by hand, or caretaker reads the service as OVERDUE even though
# the sync ran (it did exactly that on 2026-10-29). Same shape as archivist-stories.
if python3 -c "
import sqlite3, sys
from datetime import datetime, timezone, timedelta
row = sqlite3.connect('/home/ta/.local/share/archivist/archivist.db').execute('SELECT MAX(last_sync) FROM accounts').fetchone()
last = row[0]
if not last: sys.exit(0)
sys.exit(0 if datetime.now(timezone.utc) - datetime.fromisoformat(last) > timedelta(hours=16) else 1)
"; then
  sleep "$(shuf -i 0-1800 -n1)"
  /home/ta/projects/archivist/.venv/bin/archivist sync
  rc=$?
  runs="${HOME:-/home/ta}/.cache/caretaker/runs/archivist-sync"
  mkdir -p "$(dirname "$runs")"
  printf '%s 0 %s\n' "$rc" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" >> "$runs"
fi

# Run daily at 01:00-04:00 (random hour) with up to 30min jitter
exec snooze -R3h -H1 -M0 -J1800 \
  /home/ta/projects/archivist/.venv/bin/archivist sync
