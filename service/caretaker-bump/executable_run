#!/bin/sh
exec 2>&1
# 75 = deferred (the job never started), never 1 — see wait-net.
/home/ta/.local/bin/wait-net 300 || exit 75
export PATH="/home/ta/.local/bin:$PATH"
cd /home/ta/projects/caretaker
# Every 3 days at 04:00: smith template bumps (built when there are any) plus the pending official
# xbps count, in one Telegram digest, sent only when one of the two has news.
#
# The cadence is snooze's, not the job's — no state in Python:
#   -D /3    every 3rd day of the year (day-of-year, so month lengths don't skew it)
#   -H4 -M0  04:00
#   -s 3d    a slot missed while the laptop was off still runs at startup, up to 3 days late
#   -J 120   up to 2 min of jitter, so a boot-time catch-up doesn't race the other boot services
#   -t/-s    the timefile's mtime is where the next run is measured from; touch it *before* the job
#            so a failure waits for the next slot instead of looping
tf=/home/ta/.local/state/snooze/caretaker-bump
mkdir -p "${tf%/*}"
exec snooze -t "$tf" -s 3d -J 120 -D /3 -H4 -M0 \
  sh -c 'touch "$1" && exec uv run python -m caretaker.bump' sh "$tf" 2>&1
