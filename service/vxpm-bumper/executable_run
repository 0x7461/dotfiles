#!/bin/sh
export PATH="/home/ta/.local/bin:$PATH"
cd /home/ta/projects/maint-watch
# -t + -s 1d: a 04:00 slot missed while the laptop was off fires on next start
# instead of waiting a day. The job touches the timefile before running, so a
# failed run waits for the next slot rather than looping.
tf=/home/ta/.local/state/snooze/vxpm-bumper
mkdir -p "${tf%/*}"
exec snooze -t "$tf" -s 1d -H4 -M0 \
  sh -c 'touch "$1" && exec uv run python -m maint_watch.vxpm_bumper' sh "$tf" 2>&1
