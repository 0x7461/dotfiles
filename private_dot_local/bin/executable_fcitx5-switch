#!/bin/sh
# Switch fcitx5 input method via fuzzel
current=$(fcitx5-remote -n)

choice=$(printf "keyboard-us\tunikey" | tr '\t' '\n' \
  | sed "s/^${current}$/▸ ${current}/" \
  | fuzzel --dmenu --prompt "Input Method ")

[ -z "$choice" ] && exit 0
# strip marker if selected current
choice=$(echo "$choice" | sed 's/^▸ //')
fcitx5-remote -s "$choice"

label="English"
[ "$choice" = "unikey" ] && label="Vietnamese (Telex)"
notify-send "Input Method" "$label" --expire-time=2000
