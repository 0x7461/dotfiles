#!/bin/sh
text=$(echo "" | wofi --dmenu --prompt "Capture (expense / idea / todo / note)" --lines 1 --width 600)
[ -z "$text" ] && exit 0

JSON_BODY=$(printf '%s' "$text" | python3 -c 'import json,sys; print(json.dumps({"text": sys.stdin.read()}))')

RESULT=$(curl -sf --max-time 5 -X POST http://localhost:7878/capture \
  -H "Content-Type: application/json" \
  -d "$JSON_BODY" 2>/dev/null)

if [ $? -eq 0 ] && [ -n "$RESULT" ]; then
  echo "$RESULT" | python3 -c "
import json, sys, subprocess
r = json.load(sys.stdin)
t = r['type']
icons = {'expense': '💰', 'idea': '💡', 'todo': '✅', 'note': '📝'}
icon = icons.get(t, '📌')
dest = r['data'].get('appended_to', r['data'].get('text', ''))
msg = '{} {} \u2192 {}'.format(icon, t, dest)
subprocess.run(['notify-send', 'Quick Capture', msg, '--expire-time=3000'])
"
else
  QUEUE_DIR="$HOME/.local/share/quick-capture"
  mkdir -p "$QUEUE_DIR"
  printf '%s\n' "$(printf '%s' "$text" | python3 -c 'import json,sys,datetime; print(json.dumps({"text": sys.stdin.read(), "queued_at": datetime.datetime.now().isoformat()}))')" >> "$QUEUE_DIR/queue.jsonl"
  notify-send "Quick Capture" "⏳ Queued (backend offline)" --expire-time=3000
fi
