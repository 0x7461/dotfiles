#!/bin/sh
# #74: one entrypoint owns wallpaper + theme so they can't drift.
#
# usage:
#   wallpaper-theme <image>          set wallpaper + regenerate theme
#   wallpaper-theme --readapt        regenerate theme from current wallpaper
#   wallpaper-theme --pick           fuzzel picker over ~/.theme/wallpaper
#   wallpaper-theme --scheme <type>  persist matugen scheme type, then readapt
#
# Scheme persists in ~/.config/matugen/scheme (default scheme-neutral).
# ~/.theme/wallpaper/current (symlink) is the single source of truth: niri's
# spawn-at-startup swaybg and hyprlock's background both point at it.

WALLS="$HOME/.theme/wallpaper"
CURRENT="$WALLS/current"
SCHEME_FILE="$HOME/.config/matugen/scheme"
scheme=$(cat "$SCHEME_FILE" 2>/dev/null || echo scheme-neutral)

# matugen's niri reload hook needs the socket (absent in SSH shells)
[ -z "$NIRI_SOCKET" ] && NIRI_SOCKET=$(ls /run/user/"$(id -u)"/niri.*.sock 2>/dev/null | head -1) && export NIRI_SOCKET

case "$1" in
  --pick)
    img=$(find "$WALLS" -maxdepth 1 \( -type f -o -type l \) ! -name current \
      \( -name '*.png' -o -name '*.jpg' -o -name '*.jpeg' -o -name '*.webp' \) -printf '%f\n' \
      | sort | fuzzel --dmenu --prompt "wallpaper ")
    [ -z "$img" ] && exit 0
    set -- "$WALLS/$img"
    ;;
  --readapt)
    set --
    ;;
  --scheme)
    [ -n "$2" ] || { echo "usage: wallpaper-theme --scheme <scheme-type>" >&2; exit 1; }
    echo "$2" > "$SCHEME_FILE"
    scheme=$2
    set --
    ;;
  ''|-*)
    echo "usage: wallpaper-theme <image> | --readapt | --pick | --scheme <type>" >&2
    exit 1
    ;;
esac

if [ -n "$1" ]; then
  [ -f "$1" ] || { echo "no such file: $1" >&2; exit 1; }
  ln -sf "$(realpath "$1")" "$CURRENT"
  pkill -x swaybg 2>/dev/null
  setsid swaybg -i "$CURRENT" >/dev/null 2>&1 &
fi

[ -e "$CURRENT" ] || { echo "no current wallpaper ($CURRENT missing) — run: wallpaper-theme <image>" >&2; exit 1; }
img=$(realpath "$CURRENT")

# Colorless-wallpaper detection (#74): dry-run matugen with a sentinel fallback.
# Extraction never returns an achromatic color, so seeing the sentinel back
# means "no extractable color" -> force scheme-neutral for THIS run (gray
# wallpaper -> gray theme) instead of theming from matugen's vendor fallback
# seed (#4285f4). Persisted scheme is untouched: colorful wallpapers still
# get it automatically.
SENTINEL='#010101'
probe=$(matugen image "$img" --fallback-color "$SENTINEL" --prefer saturation --dry-run --json hex -m dark -q 2>/dev/null \
  | jq -r '.colors.source_color.dark.color' 2>/dev/null)
case "$probe" in
  "$SENTINEL")
    echo "wallpaper has no extractable color -> using scheme-neutral for this run (persisted: $scheme)" >&2
    scheme=scheme-neutral ;;
  '')
    echo "warn: color probe failed (matugen/jq); proceeding with $scheme" >&2 ;;
esac

# Lockscreen label styling by wallpaper luminance (#74): dark text + white halo
# on light wallpapers, light text + dark halo (subtitle-style) on dark ones.
# Variant color values come from vars.conf ($label*On{Light,Dark}, matugen-generated).
# -alpha off is load-bearing: fx:mean averages an alpha channel in, so an
# opaque black PNG would read ~0.5 and misclassify as light
lum=$(magick "$img" -alpha off -resize 64x64! -colorspace gray -format '%[fx:mean]' info: 2>/dev/null)
case "$lum" in
  '') echo "warn: luminance probe failed (magick); keeping existing labels.conf" >&2 ;;
  *)
    if [ "$(printf '%s > 0.4\n' "$lum" | bc)" = 1 ]; then variant=Light; halo='rgba(255,255,255,0.9)'
    else variant=Dark; halo='rgba(0,0,0,0.9)'; fi
    cat > "$HOME/.theme/hyprlock/labels.conf" << EOF
# Generated by wallpaper-theme — do not hand-edit.
# Wallpaper mean luminance: $lum -> ${variant}-wallpaper label set.
\$labelPrimary = \$labelPrimaryOn$variant
\$labelSecondary = \$labelSecondaryOn$variant
\$labelDim = \$labelDimOn$variant
\$halo = $halo
EOF
    ;;
esac

# matugen sniffs image format by extension — feed it the resolved target,
# not the extensionless symlink (swaybg/hyprlock read content, matugen doesn't)
exec matugen image "$img" -t "$scheme" --prefer saturation -m dark
