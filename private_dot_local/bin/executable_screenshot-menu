#!/bin/sh
DIR="$HOME/Pictures"
NAME="$(date +%Y%m%d_%Hh%Mm%Ss)"
RECPID="/tmp/wf-recorder.pid"
OUT="$DIR/${NAME}_grim.png"

save() {
    wl-copy < "$1"
    notify-send "Screenshot" "Saved to ${1##*/}" --expire-time=3000
}

choice=$(printf "\
Full screen
Region select
Window select
Delay 3s → full
Delay 3s → region
Record region
Stop recording" | wofi -d -p "Screenshot" -i)

case "$choice" in
    "Full screen")
        grim "$OUT" && save "$OUT"
        ;;
    "Region select")
        region=$(slurp) || exit 0
        grim -g "$region" "$OUT" && save "$OUT"
        ;;
    "Window select")
        region=$(hyprctl clients -j | python3 -c "
import json, sys
clients = json.load(sys.stdin)
lines = []
for c in clients:
    if c['mapped']:
        at = c['at']
        size = c['size']
        lines.append('{},{} {}x{} {}'.format(at[0], at[1], size[0], size[1], c['title']))
print('\n'.join(lines))
" | slurp -r) || exit 0
        grim -g "$region" "$OUT" && save "$OUT"
        ;;
    "Delay 3s → full")
        notify-send "Screenshot" "3 seconds..." --expire-time=2000
        sleep 3
        grim "$OUT" && save "$OUT"
        ;;
    "Delay 3s → region")
        region=$(slurp) || exit 0
        notify-send "Screenshot" "3 seconds..." --expire-time=2000
        sleep 3
        grim -g "$region" "$OUT" && save "$OUT"
        ;;
    "Record region")
        if [ -f "$RECPID" ]; then
            notify-send "Recording" "Already recording — stop first" --expire-time=2000
            exit 1
        fi
        region=$(slurp) || exit 0
        wf-recorder -g "$region" -f "$DIR/${NAME}_rec.mp4" &
        echo $! > "$RECPID"
        notify-send "Recording" "Started — use Stop recording to finish" --expire-time=3000
        ;;
    "Stop recording")
        if [ -f "$RECPID" ]; then
            kill "$(cat "$RECPID")" 2>/dev/null
            rm "$RECPID"
            notify-send "Recording" "Saved to $DIR/" --expire-time=3000
        else
            notify-send "Recording" "Nothing to stop" --expire-time=2000
        fi
        ;;
esac
